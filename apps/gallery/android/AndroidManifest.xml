<?xml version="1.0" encoding="utf-8"?>
<!--
  dx 0.7.10's Android manifest with one change: the activity handles every configuration
  change itself. dx's default only lists orientation, screen size and keyboardHidden, so a
  dark-mode switch, font scale, density, locale or keyboard change made Android destroy and
  recreate the activity, and the app aborted ("pthread_mutex_lock called on a destroyed
  mutex") because the Rust side cannot survive a recreated NativeActivity.
  dx copies this file as-is (no template), so keep it in step with dx's
  assets/android/gen/app/src/main/AndroidManifest.xml.hbs when dx is upgraded.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:hasCode="true" android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowNativeHeapPointerTagging="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|touchscreen|uiMode|density|fontScale|locale|layoutDirection|mcc|mnc|colorMode"
            android:exported="true"
            android:label="@string/app_name" android:name="dev.dioxus.main.MainActivity">
            <meta-data android:name="android.app.lib_name" android:value="main" />
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
